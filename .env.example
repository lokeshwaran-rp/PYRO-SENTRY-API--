# PYRO-SENTRY Environment Configuration
PROJECT_NAME="PYRO-SENTRY Industrial Thermal Surveillance API"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://pyro:pyro@localhost:5432/pyrosentry

# Redis (Pub/Sub + caching)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
PYRO_JWT_SECRET=changeme-in-production-use-openssl-rand-hex-32
PYRO_JWT_ALGORITHM=HS256
PYRO_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
PYRO_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
